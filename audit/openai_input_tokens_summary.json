  ],
  "definitions": {
    "decision_call": "the final API call (`<case>_final.json`); its input carries both tool payloads",
    "call1": "the first API call (`<case>_response1.json`): system prompt, user message and tool schema; no tool payload",
    "reconstructed": "sum of tiktoken counts of each message content and function output in the call input, replayed with src/runner.py",
    "offset": "logged usage.input_tokens minus reconstructed",
    "cf_*_added": "tokens added when the hidden field is serialized into both payloads",
    "cf_*_offset": "logged minus the counterfactual reconstruction (= offset - added)",
    "median_shift": "median(cf offset) - median(offset)",
    "slope_offset_on_added": "OLS slope of the observed offset on the tokens the field would add: 0 if the field was absent, 1 if it was present",
    "structure": "tool calls per tool-calling response: AB = both in call 1; A|B = one per call; -|AB = none, then both",
    "twice_logged_minus_reconstructed": "call-1 diagnostic, 2 x logged - reconstructed, by number of function calls the model emitted in call 1",
    "informative_subset": "records whose added tokens differ from the modal added count by more than 2; only these can tell the counterfactual from the reconstruction, since a constant addition is absorbed by the offset. If the field had been sent, their observed offset would exceed the rest's by predicted_difference (added - modal added); observed_difference is the difference of median observed offsets",
    "multi_call_records": "every API call of the records with more than one tool-calling response"
  },
